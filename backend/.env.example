# Copy to .env and fill in real values. Never commit .env.

# PostgreSQL connection (dev database per CLAUDE.md).
# Check your cluster's port with `pg_lsclusters` — it is not always 5432.
DATABASE_URL="postgresql://rrbs_user:CHANGE_ME@localhost:5432/rrbs_dev?schema=public"

# API server
PORT=4000

# JWT signing secret — generate with: openssl rand -base64 32
JWT_SECRET="CHANGE_ME"
JWT_EXPIRES_IN="8h"

# --- Deployment topology ----------------------------------------------------
# These matter in production; the development defaults below are deliberate.
# See .env.production.example for the production guidance.

# Comma-separated browser origins allowed to call the API. Blank means `*`,
# which is right for development (Vite on :5173 calling the API on :4000) and
# wrong for a split production deployment.
CORS_ORIGIN=

# Number of reverse proxies in front of the API. 0 in development — the app is
# reached directly. Set to 1 behind Nginx, Render or Railway, so rate limiting
# reads the real client IP instead of a spoofable header.
TRUST_PROXY=0

# Throttle on /api/auth/* per IP (SRS §8). Raise the ceiling if repeated
# sign-ins during development start tripping it.
AUTH_RATE_LIMIT_WINDOW_MINUTES=15
AUTH_RATE_LIMIT_MAX=20

# --- Business settings (SRS §10 — confirm these with the client) -------------

# Tax percentages, applied AFTER any discount (SRS §5.3).
# Rooms and food may carry different rates.
ROOM_TAX_PERCENT=0
FOOD_TAX_PERCENT=0

# Minimum share of a booking total that must be paid before Pending -> Confirmed.
# SRS §5.1 allows "in full or in part", so 0 means any payment above zero.
BOOKING_MIN_ADVANCE_PERCENT=0

# Minutes after the scheduled start before a booking counts as a no-show.
BOOKING_NO_SHOW_GRACE_MINUTES=120

# Minimum subtotal for a Delivery order (SRS §5.2). 0 means no minimum.
FOOD_DELIVERY_MIN_AMOUNT=0

# Pagination defaults for list endpoints.
DEFAULT_PAGE_SIZE=20
MAX_PAGE_SIZE=100

# --- Notifications (SRS §4.8) ------------------------------------------------

# Comma-separated transports a notification is pushed through once its row is
# written: `log` (structured server-log line, the default) and `email`.
# Every notification is recorded in the `notifications` table either way.
NOTIFICATION_CHANNELS=log

# SMTP for the `email` channel. Leave SMTP_HOST blank to keep email switched
# off — the transport is skipped, never treated as an error.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM="RRBS <no-reply@rrbs.local>"
