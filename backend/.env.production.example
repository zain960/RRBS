# Backend production environment — copy to `.env` on the server and fill in.
#
#   cp .env.production.example .env
#
# Never commit the filled-in file. On a PaaS (Render/Railway) there is no file:
# set each of these as a dashboard environment variable instead.
#
# Differences from .env.example (development) are called out below; the values
# here are the ones that must NOT be left at their development defaults.

NODE_ENV=production

# --- Database ---------------------------------------------------------------

# Managed PostgreSQL almost always requires TLS. Neon, Supabase and Railway
# accept `?sslmode=require`; Render's internal URL does not need it. Append
# `&schema=public` if your provider's URL does not already name a schema.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DBNAME?schema=public&sslmode=require"

# --- API server -------------------------------------------------------------

# A PaaS injects its own PORT and ignores this. Keep it for a VPS, where Nginx
# proxies to this port.
PORT=4000

# --- Auth -------------------------------------------------------------------

# REQUIRED. Generate a fresh one per environment — never reuse the development
# secret. Rotating it invalidates every issued token, signing all users out.
#   openssl rand -base64 32
JWT_SECRET="REPLACE_WITH_openssl_rand_base64_32"
JWT_EXPIRES_IN="8h"

# --- Deployment topology ----------------------------------------------------

# Browser origins allowed to call this API, comma-separated.
#
# SINGLE-SERVICE (option A — Express serves the built frontend): leave blank or
# omit. The frontend is same-origin, so no CORS grant is needed and `*` would
# only widen the surface for nothing.
#
# SPLIT (option B — frontend on Vercel/Netlify): REQUIRED. Name the frontend's
# exact origin(s), scheme included, no trailing slash. Do not use `*` here: the
# API is called with a bearer token, so any origin being allowed to read the
# response is a real exposure.
#   CORS_ORIGIN=https://your-domain.com,https://www.your-domain.com
CORS_ORIGIN=

# Number of reverse proxies in front of this app. Rate limiting keys on the
# client IP, which arrives in X-Forwarded-For once a proxy is involved — this
# tells Express how many hops to trust, so a caller cannot spoof the header and
# slip past the throttle.
#
#   0  no proxy (the app is exposed directly — unusual in production)
#   1  Nginx on a VPS, or Render/Railway/Fly (each adds exactly one)
#   2  a CDN in front of one of the above (e.g. Cloudflare -> Nginx)
TRUST_PROXY=1

# --- Rate limiting (SRS §8) -------------------------------------------------

# Throttle on /api/auth/* — the only unauthenticated endpoints that take
# credentials. Per IP. The defaults leave normal sign-in well clear while
# making a password sweep impractical; lower the ceiling if the deployment
# faces the open internet with no WAF.
AUTH_RATE_LIMIT_WINDOW_MINUTES=15
AUTH_RATE_LIMIT_MAX=20

# --- Business settings (SRS §10 — confirm these with the client) ------------

# Tax percentages are seeded from here into the `settings` table on first run,
# after which the Tax Settings screen owns them and this value is ignored.
ROOM_TAX_PERCENT=0
FOOD_TAX_PERCENT=0

# Minimum share of a booking total payable before Pending -> Confirmed.
# 0 means any payment above zero confirms; 25 requires a quarter up front.
BOOKING_MIN_ADVANCE_PERCENT=0

# Minutes after the scheduled start before a booking counts as a no-show.
BOOKING_NO_SHOW_GRACE_MINUTES=120

# Minimum subtotal for a Delivery order. 0 means no minimum.
FOOD_DELIVERY_MIN_AMOUNT=0

# Pagination defaults for list endpoints.
DEFAULT_PAGE_SIZE=20
MAX_PAGE_SIZE=100

# --- Notifications (SRS §4.8) -----------------------------------------------

# `log` writes a structured server-log line; `email` delivers over SMTP.
# Production usually wants both, so a failed send is still traceable in the
# logs. Every notification is recorded in `notifications` either way.
NOTIFICATION_CHANNELS=log,email

# SMTP for the `email` channel. A blank SMTP_HOST switches email off — the
# transport is skipped, never treated as an error — so an incomplete mail
# configuration cannot break a check-in.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM="RRBS <no-reply@your-domain.com>"
