# Frontend build-time settings (Vite).
#
# Vite inlines VITE_* variables into the bundle at build time, so these are
# BAKED IN — changing one means rebuilding, not restarting. Never put a secret
# here: everything in this file ships to the browser in readable form.
#
# This file is committed on purpose. It holds the defaults for a production
# build and contains no credentials.

# Absolute origin of the API, used only in a SPLIT deployment where the
# frontend is hosted separately from the backend (Vercel/Netlify + Render/
# Railway — docs/DEPLOY.md option B). Include the /api suffix.
#
#   VITE_API_BASE_URL=https://api.your-domain.com/api
#
# Left BLANK for the single-service deployment (option A), where Express serves
# this bundle from backend/public and the API is same-origin. A blank value
# falls back to the relative path /api, which is what you want there — set this
# only if the API is on another origin.
VITE_API_BASE_URL=
